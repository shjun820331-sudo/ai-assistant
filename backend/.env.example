# 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env 는 깃허브에 올라가지 않습니다)

# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Firebase 서비스 계정 키: 내 PC에서는 파일 경로, 배포(Render)에서는 JSON 내용 전체를 사용
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS 허용 주소 (쉼표로 구분). 배포 후 Vercel 주소를 추가하세요.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
